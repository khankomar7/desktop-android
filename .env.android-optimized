# ============================================================================
# Android-Optimized Performance Profile
# ============================================================================
# This configuration prioritizes fast, responsive desktop access on Android
# devices over visual quality. It's designed for:
# - Quick page transitions and screen updates (low latency)
# - Smooth touch interaction on mobile browsers
# - Efficient bandwidth usage on cellular networks
# - Fast login and authentication response times
# ============================================================================

# Required webtop login credentials
WEBTOP_USER=admin
WEBTOP_PASSWORD=change-this-to-a-long-random-password

# ---- CRITICAL ANDROID SETTINGS ----
# These directly impact responsiveness and feel:

# Stream resolution: 720p is sweet spot for mobile (readable, fast encoding)
# Alternatives: 960x540 (ultra-fast), 1280x720 (balanced), 1920x1080 (quality)
MAX_RES=1280x720

# Stream frame rate: 24 fps feels smooth on touch, lower = faster updates
# Typical: 20 fps (ultra-responsive), 24 fps (balanced), 30 fps (smooth)
SELKIES_FRAMERATE=24

# Video encoding quality: Higher CRF = smaller file, faster encode, lower quality
# Android will thank you: 30-32 (fast), 28 (default), 24 (high quality)
SELKIES_H264_CRF=30

# Stream encoding method: x264enc-striped is fastest, lowest-latency encoder
SELKIES_ENCODER=x264enc-striped

# ---- INPUT & RESPONSIVENESS ----
# These affect how your touch and trackpad feel:

# Use browser's CSS scaling instead of server-side scaling (faster on mobile)
SELKIES_USE_CSS_SCALING=true

# Use browser mouse cursors (lighter than server-rendered, more responsive)
SELKIES_USE_BROWSER_CURSORS=true

# Force aligned resolution (prevents scaling artifacts, cleaner UI)
SELKIES_FORCE_ALIGNED_RESOLUTION=true

# DPI scaling (96 = standard, matches most Android devices)
SELKIES_SCALING_DPI=96

# Paint over quality: prioritize visual feedback speed over perfection
SELKIES_USE_PAINT_OVER_QUALITY=true

# ---- DISABLE EXPENSIVE FEATURES ----
# These add bandwidth, latency, and complexity on mobile:

SELKIES_AUDIO_ENABLED=false
SELKIES_MICROPHONE_ENABLED=false
SELKIES_GAMEPAD_ENABLED=false
SELKIES_ENABLE_BINARY_CLIPBOARD=false
SELKIES_CLIPBOARD_ENABLED=true
SELKIES_FILE_TRANSFERS=none
SELKIES_ENABLE_SHARING=false
SELKIES_SECOND_SCREEN=false

# ---- MINIMAL UI ----
# Hide unnecessary sidebar items for cleaner, faster interface:

SELKIES_UI_SIDEBAR_SHOW_AUDIO_SETTINGS=false
SELKIES_UI_SHOW_CORE_BUTTONS=false
SELKIES_UI_SIDEBAR_SHOW_FILES=false
SELKIES_UI_SIDEBAR_SHOW_SHARING=false
SELKIES_UI_SIDEBAR_SHOW_GAMEPADS=false
SELKIES_UI_SIDEBAR_SHOW_STATS=false
SELKIES_UI_SIDEBAR_SHOW_GAMING_MODE=false

# Keep only essentials visible on mobile:
SELKIES_UI_SIDEBAR_SHOW_SCREEN_SETTINGS=true
SELKIES_UI_SIDEBAR_SHOW_VIDEO_SETTINGS=true
SELKIES_UI_SIDEBAR_SHOW_CLIPBOARD=true
SELKIES_UI_SIDEBAR_SHOW_TRACKPAD=true
SELKIES_UI_SIDEBAR_SHOW_FULLSCREEN=true
SELKIES_UI_SIDEBAR_SHOW_KEYBOARD_BUTTON=true

# ---- SYSTEM RESOURCES ----
# Container resource limits (adjust based on your host):

PUID=1000
PGID=1000
TZ=Asia/Tehran
WEBTOP_HTTPS_BIND=0.0.0.0
CPU_LIMIT=4
MEMORY_LIMIT=4G

# ---- NETWORK & BINDING ----
WEBTOP_HTTPS_BIND=0.0.0.0

# ============================================================================
# PRESETS: Comment out the above and uncomment a profile below for different needs
# ============================================================================

# --- ULTRA-FAST (Weak 3G/4G, maximum responsiveness) ---
# Uncomment these lines to use the ultra-fast profile:
# MAX_RES=960x540
# SELKIES_FRAMERATE=20
# SELKIES_H264_CRF=32

# --- QUALITY (Strong WiFi/5G, visual quality priority) ---
# Uncomment these lines to use the quality profile:
# MAX_RES=1920x1080
# SELKIES_FRAMERATE=30
# SELKIES_H264_CRF=28
