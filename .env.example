# Required webtop login. Use a long, unique password outside local testing.
WEBTOP_USER=admin
WEBTOP_PASSWORD=change-this-to-a-long-random-password

# Optional runtime settings
PUID=1000
PGID=1000
TZ=Asia/Tehran
WEBTOP_HTTPS_BIND=0.0.0.0
MAX_RES=1280x720
SELKIES_ENCODER=x264enc-striped
SELKIES_FRAMERATE=24
SELKIES_H264_CRF=30
SELKIES_AUDIO_ENABLED=false
SELKIES_MICROPHONE_ENABLED=false
SELKIES_GAMEPAD_ENABLED=false
SELKIES_FILE_TRANSFERS=none
SELKIES_ENABLE_SHARING=false
CPU_LIMIT=4
MEMORY_LIMIT=4G

# --- Presets: uncomment one block ---
# Speed (weak mobile network / fastest window switching):
# MAX_RES=960x540
# SELKIES_FRAMERATE=20
# SELKIES_H264_CRF=32
# Balanced (default, already set above):
# MAX_RES=1280x720
# SELKIES_FRAMERATE=24
# SELKIES_H264_CRF=30
